# Bağımlılıklar
node_modules/

# Resim klasöründeki her şeyi yoksay...
images/*

# ...ama .gitkeep dosyasını istisna tut (klasör yapısı korunsun)
!images/.gitkeep

# Çalışma zamanı veri klasörü (.gitkeep hariç tüm dinamik verileri yoksay)
data/*
!data/.gitkeep

# Çevre değişkenleri ve loglar
.env
*.log
admin-password.json
selected-images.json*
server-settings.json*
activity-log.json*
thumbnails/

# Installer output
installer_output/
installer/tools/*.exe
